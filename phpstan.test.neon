includes:
    - phpstan.common.neon
parameters:
    resultCachePath: %tmpDir%/resultCache-tests.php
    paths:
        - tests
    excludePaths:
        # Generated by Symfony Flex's symfony/phpunit-bridge recipe in CI; not part of the bundle.
        analyseAndScan:
            - tests/bootstrap.php (?)
    ignoreErrors:
        # Cross-version compat: enableNativeLazyObjects exists on ORM 3 only; the test supports both ORM 2 and 3.
        -
            identifier: function.alreadyNarrowedType
            message: '#method_exists\(\).*enableNativeLazyObj#'
        -
            identifier: function.impossibleType
            message: '#method_exists\(\).*enableNativeLazyObj#'
